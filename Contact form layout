<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>EchoSee – Contact (Day 1: Layout)</title>
  <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;600;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>
 
</head>
<body>
<!-- CONTACT SECTION -->
<section class="contact-section">
  <p class="section-label">Get In Touch</p>
  <h2 class="section-title">Contact Us</h2>
  <p class="section-sub">Have questions about EchoSee? We'd love to hear from you. Reach out and our team will respond within 24 hours.</p>

  <div class="contact-grid">

    <!-- LEFT: Info -->
    <aside class="info-panel">

      <div class="info-card">
        <div class="info-icon">📧</div>
        <div>
          <h4>Email</h4>
          <p>hello@echosee.pk</p>
        </div>
      </div>

      <div class="info-card">
        <div class="info-icon">📞</div>
        <div>
          <h4>Phone</h4>
          <p>+92 300 1234567</p>
        </div>
      </div>

      <div class="info-card">
        <div class="info-icon">📍</div>
        <div>
          <h4>Address</h4>
          <p>EchoSee HQ, Islamabad, Pakistan</p>
        </div>
      </div>

      <div class="info-card">
        <div class="info-icon">🌐</div>
        <div>
          <h4>Follow Us</h4>
          <div class="social-row" style="margin-top:.6rem">
            <a class="social-btn" aria-label="Facebook">f</a>
            <a class="social-btn" aria-label="Instagram">in</a>
            <a class="social-btn" aria-label="Twitter">𝕏</a>
            <a class="social-btn" aria-label="LinkedIn">Li</a>
          </div>
        </div>
      </div>

    </aside>

    <!-- RIGHT: Form -->
    <div class="form-panel">
      <form novalidate aria-label="Contact form">
        <div class="form-row">
          <div class="field-group">
            <input type="text" id="fname" placeholder=" " autocomplete="given-name" required />
            <label for="fname">First Name</label>
          </div>
          <div class="field-group">
            <input type="text" id="lname" placeholder=" " autocomplete="family-name" required />
            <label for="lname">Last Name</label>
          </div>
          <div class="field-group">
            <input type="email" id="email" placeholder=" " autocomplete="email" required />
            <label for="email">Email Address</label>
          </div>
          <div class="field-group">
            <input type="tel" id="phone" placeholder=" " autocomplete="tel" />
            <label for="phone">Phone (optional)</label>
          </div>
          <div class="field-group full">
            <select id="subject">
              <option value="" disabled selected></option>
              <option>Pre-Order Enquiry</option>
              <option>Product Support</option>
              <option>Partnership</option>
              <option>Press / Media</option>
              <option>Other</option>
            </select>
            <label for="subject">Subject</label>
          </div>
          <div class="field-group full">
            <textarea id="message" placeholder=" " required></textarea>
            <label for="message">Your Message</label>
          </div>
        </div>
        <button type="submit" class="btn-submit">Send Message</button>
      </form>
    </div>

  </div>
</section>

</body>
</html>
